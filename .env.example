# =============================================================================
# ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# Скопируйте этот файл в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в git!
# =============================================================================

# Подключение к MySQL
# Локально: mysql://fattoria_user:fattoria_pass@localhost:3306/fattoria_db
# На проде (hoster.by): mysql://USER:PASSWORD@localhost:3306/fattoriaby_parsing
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DB_NAME"

# URL фида Realt.by (актуальный URL с логином/паролем)
# Формат: https://realt.by/bff/proxy/export/api/export/?login=XXX&password=XXX&format=realt&type=1,3,4,2001,2002,1000&config[type]=2
REALT_FEED_URL="https://realt.by/bff/proxy/export/api/export/?login=XXX&password=XXX&format=realt&type=1,3,4,2001,2002,1000&config[type]=2"

# Окружение
NODE_ENV="development"

# Порт приложения
# Локально: 3000
# На проде (hoster.by): 10003
PORT=3000
